#compdef func
# zsh completion for func. Generated by `func completions zsh`.
# Install: func completions zsh > ~/.zfunc/_func   (with ~/.zfunc in $fpath, before compinit)
#      or: eval "$(func completions zsh)"           (after compinit)

_func_scripts() {
    local -a scripts
    scripts=( ${(f)"$(func list --names 2>/dev/null)"} )
    (( ${#scripts} )) && _describe -t scripts 'script' scripts
}

# Completes flags when the word being typed starts with "-". Succeeds if it did.
_func_flags() {
    [[ $words[CURRENT] == -* ]] || return 1
    (( $# )) && compadd -- "$@"
    return 0
}

_func() {
    local -a commands
    commands=(
        'edit:Create or edit a script, then type-check it'
        'run:Compile (once, then cached) and run a script'
        'test:Run the script'\''s #[test] functions'
        'check:Type-check a script without building it'
        'eval:Run a snippet without saving it'
        'install:Build a release binary and put it on your PATH'
        'list:List your scripts'
        'show:Print a script'\''s source'
        'path:Print where a script (or the script directory) lives'
        'rename:Rename a script'
        'remove:Delete scripts'
        'clean:Delete cached builds'
        'completions:Print a shell completion script'
        'help:Show help'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'command' commands
        return
    fi

    local -i positional=0 i
    for (( i = 3; i < CURRENT; i++ )); do
        [[ $words[i] == -* ]] || (( positional++ ))
    done

    case $words[2] in
        edit|new|e) _func_flags  || (( positional == 0 )) && _func_scripts ;;
        run|r) _func_flags -r --release || { if (( positional == 0 )); then _func_scripts; _files -g '*.rs'; else _files; fi } ;;
        test|t) _func_flags  || { if (( positional == 0 )); then _func_scripts; _files -g '*.rs'; else _files; fi } ;;
        check) _func_flags  || { if (( positional == 0 )); then _func_scripts; _files -g '*.rs'; else _files; fi } ;;
        eval) _func_flags -r --release ;;
        install) _func_flags -f --force || { if (( positional == 0 )); then _func_scripts; _files -g '*.rs'; else _files; fi } ;;
        list|ls) _func_flags --names ;;
        show|cat) _func_flags  || (( positional == 0 )) && _func_scripts ;;
        path) _func_flags  || (( positional == 0 )) && _func_scripts ;;
        rename|mv) _func_flags  || (( positional == 0 )) && _func_scripts ;;
        remove|rm) _func_flags -y --yes || _func_scripts ;;
        clean) _func_flags  ;;
        completions) (( positional == 0 )) && compadd -- bash zsh fish ;;
        help) (( positional == 0 )) && _describe -t commands 'command' commands ;;
        *) ;;
    esac
}

if [[ ${funcstack[1]} == _func ]]; then
    _func "$@"
else
    compdef _func func
fi
